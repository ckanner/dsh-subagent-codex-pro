{
  "name": "dsh-subagent-codex-pro",
  "version": "0.10.0",
  "description": "A Codex delegation tool for DeepSeek Harness that can carry a model and a reasoning effort per call.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./machine": {
      "types": "./lib/types/machine.d.ts",
      "default": "./lib/machine.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "codex-pro-machine": "lib/machine-cli.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "docs/README.zh.md",
    "docs/machine.md",
    "docs/orchestration.zh.md",
    "LICENSE",
    "docs/machine-lifecycle.md",
    "docs/machine-lifecycle.zh.md",
    "docs/machine-lifecycle-validation.md",
    "docs/native-capabilities.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"tests/*.spec.ts\"",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "prepublishOnly": "npm run build",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**/*.ts\" \"tests/*.spec.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "homepage": "https://github.com/ckanner/dsh-subagent-codex-pro#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ckanner/dsh-subagent-codex-pro.git"
  },
  "bugs": {
    "url": "https://github.com/ckanner/dsh-subagent-codex-pro/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "cordis",
    "codex",
    "subagent",
    "delegation"
  ],
  "publishConfig": {
    "access": "public"
  }
}
